   "precision": "2"
  },
  {
   "fieldname": "max_tokens",
   "fieldtype": "Int",
   "label": "Maximum reply tokens",
   "default": "800",
   "non_negative": 1
  },
  {
   "fieldname": "request_timeout",
   "fieldtype": "Int",
   "label": "Request timeout (seconds)",
   "default": "30",
   "non_negative": 1
  },
  {
   "fieldname": "prompt_section",
   "fieldtype": "Section Break",
   "label": "Instructions"
  },
  {
   "fieldname": "system_prompt",
   "fieldtype": "Long Text",
