   "default": "2000",
   "non_negative": 1
  },
  {
   "fieldname": "limits_col_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "rate_limit_per_minute",
   "fieldtype": "Int",
   "label": "Messages per user per minute",
   "default": "10",
   "non_negative": 1
  },
  {
   "fieldname": "rate_limit_per_day",
